# Python bytecode
__pycache__/
*.py[cod]

# Virtualenvs — CI installs into the runner, so these are always local-only
.venv/
venv/

# Tool caches
.pytest_cache/
.ruff_cache/

# Local secrets. The pipeline reads RENDER_DEPLOY_HOOK from GitHub Actions
# secrets, never from a committed file.
.env

# Test report generated by `pytest --junitxml`; CI uploads it as an artifact
# instead of committing it.
results.xml

# macOS Finder metadata
.DS_Store
